<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for API 30 and below (research R13).
   The encrypted database and its wrapped key must never leave the device.
-->
<full-backup-content>
    <exclude domain="database" path="spendless.db" />
    <exclude domain="database" path="spendless.db-wal" />
    <exclude domain="database" path="spendless.db-shm" />
    <exclude domain="database" path="spendless.db-journal" />
    <exclude domain="root" path="no_backup/spendless_db_key.bin" />
</full-backup-content>
